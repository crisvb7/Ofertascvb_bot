# Copia este archivo como .env y rellénalo.

# Telegram (recomendado). Token de @BotFather; el chat id lo saca: python bot.py --chat-id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp vía CallMeBot (opcional, gratis para uso personal).
# Teléfono con prefijo, p. ej. +34600111222. La apikey te la da el bot de CallMeBot.
CALLMEBOT_TELEFONO=
CALLMEBOT_APIKEY=

# Dónde guardar la base de datos (por defecto datos/ofertas.db)
# RUTA_BD=datos/ofertas.db
